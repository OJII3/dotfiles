(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps
  spc
  muhenkan
  ralt
  rctl
  e
  a
  n
  p
)

(defvar
  tap-time  200
  hold-time 200
)

(defalias
  caps     (tap-hold-press $tap-time $hold-time esc lctl)
  spc      (tap-hold-press $tap-time $hold-time spc lmet)
  muhenkan (tap-hold-press $tap-time $hold-time spc lmet)
  ralt     (tap-hold-press $tap-time $hold-time kana ralt)
  e        (switch ((input real caps) (input real rctl)) (unmod end) break () e break)
  a        (switch ((input real caps) (input real rctl)) (unmod home) break () a break)
  n        (switch ((input real caps) (input real rctl)) (unmod down) break () n break)
  p        (switch ((input real caps) (input real rctl)) (unmod up) break () p break)
)

(deflayer base
  @caps
  @spc
  @muhenkan
  @ralt
  rctl
  @e
  @a
  @n
  @p
)

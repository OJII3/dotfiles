{
  "$schema": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json",
  "permissions": {
    "allow": [
      "read_file(/home/ojii3/src/github.com)",
      "read_file(/Users/ojii3/src/github.com)"
    ]
  },
  "trustedWorkspaces": [
    "/home/ojii3",
    "/Users/ojii3"
  ],
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "general": {
    "previewFeatures": true,
    "vimMode": false,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "1w"
    }
  },
  "ui": {
    "showStatusInTitle": true,
    "showMemoryUsage": true,
    "showModelInfoInChat": true
  },
  "telemetry": {
    "enabled": false
  },
  "tools": {
    "enableHooks": true,
    "autoAccept": true,
    "allowed": [
      "google_web_search",
      "run_shell_command(*)",
      "read_file(/home/ojii3/src/github.com/)",
      "read_file(/Users/ojii3/src/github.com/)"
    ]
  }
}

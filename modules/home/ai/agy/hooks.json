{
  "langfuse": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/lib/agy-langfuse/hook PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "~/.local/lib/agy-langfuse/hook PostInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.local/lib/agy-langfuse/hook Stop",
        "timeout": 10
      }
    ]
  }
}

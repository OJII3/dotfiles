{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": true,
  "mcp": {
    "onshape": {
      "type": "local",
      "command": ["onshape-mcp"],
      "enabled": true,
    },
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
    },
    "edit": "allow",
    "external_directory": {
      "/tmp/**": "allow",
      "/nix/store/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "glob": "allow",
    "lsp": "allow"
  }
}

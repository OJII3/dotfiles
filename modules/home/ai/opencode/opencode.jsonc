{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": true,
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
    },
    "edit": "allow",
    "external_directory": {
      "/tmp/**": "allow",
      "/nix/store/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "glob": "allow",
    "lsp": "allow"
  },
  "experimental": {
    "openTelemetry": true
  }
}

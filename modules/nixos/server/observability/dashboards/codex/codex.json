{
  "id": null,
  "uid": "codex-local",
  "title": "Codex CLI (Local)",
  "description": "Local adaptation of Grafana dashboard 25338-codex. Codex OTLP metrics are converted by Alloy to Prometheus metrics; logs and traces are stored in Loki and Tempo.",
  "tags": [
    "codex",
    "opentelemetry",
    "prometheus",
    "loki",
    "tempo"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Summary KPIs",
      "id": 100,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Sessions",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Codex threads started during the selected time range.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(codex_thread_started_total[$__range]))",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "type": "stat",
      "title": "Turns",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Conversation turns during the selected time range.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(codex_conversation_turn_count_total[$__range]))", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "type": "stat",
      "title": "Total Tokens",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total tokens reported by Codex turns.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(codex_turn_token_usage_sum{token_type=\"total\"}[$__range]))", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "type": "stat",
      "title": "Tool Calls",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tool calls during the selected time range.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(codex_tool_call_total[$__range]))", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "yellow" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "type": "stat",
      "title": "Prompt Cache Hit Rate",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "100 * sum(increase(codex_turn_token_usage_sum{token_type=\"cached_input\"}[$__range])) / clamp_min(sum(increase(codex_turn_token_usage_sum{token_type=\"input\"}[$__range])), 1)", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "orange", "value": 50 }, { "color": "green", "value": 80 }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "type": "stat",
      "title": "Tool Failure Rate",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "100 * sum(increase(codex_tool_call_total{success=\"false\"}[$__range])) / clamp_min(sum(increase(codex_tool_call_total[$__range])), 1)", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 10 }, { "color": "red", "value": 25 }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "type": "stat",
      "title": "p95 Turn Latency",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(codex_turn_e2e_duration_ms_bucket[$__rate_interval]))) / 1000", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "light-blue" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "type": "stat",
      "title": "p95 First Token",
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(codex_turn_ttft_duration_ms_bucket[$__rate_interval])))", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "light-blue" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "type": "row",
      "title": "Token Usage",
      "id": 200,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Token Usage by Type",
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        { "refId": "A", "expr": "sum by (token_type) (increase(codex_turn_token_usage_sum{token_type!=\"total\"}[$__rate_interval]))", "legendFormat": "{{token_type}}", "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [], "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "piechart",
      "title": "Tokens by Model",
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "refId": "A", "expr": "sum by (model) (increase(codex_turn_token_usage_sum{token_type=\"total\"}[$__range]))", "legendFormat": "{{model}}", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "pieType": "pie", "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "right", "values": ["value", "percent"] } }
    },
    {
      "type": "row",
      "title": "Latency",
      "id": 300,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Turn Latency Percentiles",
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(codex_turn_e2e_duration_ms_bucket[$__rate_interval]))) / 1000", "legendFormat": "p50", "format": "time_series" },
        { "refId": "B", "expr": "histogram_quantile(0.90, sum by (le) (rate(codex_turn_e2e_duration_ms_bucket[$__rate_interval]))) / 1000", "legendFormat": "p90", "format": "time_series" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(codex_turn_e2e_duration_ms_bucket[$__rate_interval]))) / 1000", "legendFormat": "p99", "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1, "mappings": [], "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "First Response Latency",
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(codex_turn_ttft_duration_ms_bucket[$__rate_interval])))", "legendFormat": "ttft p50", "format": "time_series" },
        { "refId": "B", "expr": "histogram_quantile(0.90, sum by (le) (rate(codex_turn_ttft_duration_ms_bucket[$__rate_interval])))", "legendFormat": "ttft p90", "format": "time_series" },
        { "refId": "C", "expr": "histogram_quantile(0.50, sum by (le) (rate(codex_turn_ttfm_duration_ms_bucket[$__rate_interval])))", "legendFormat": "ttfm p50", "format": "time_series" },
        { "refId": "D", "expr": "histogram_quantile(0.90, sum by (le) (rate(codex_turn_ttfm_duration_ms_bucket[$__rate_interval])))", "legendFormat": "ttfm p90", "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0, "mappings": [], "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row",
      "title": "Usage Over Time",
      "id": 400,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Sessions over Time",
      "id": 14,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(codex_thread_started_total[$__rate_interval]))", "legendFormat": "sessions", "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [], "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } }
    },
    {
      "type": "timeseries",
      "title": "Turns over Time",
      "id": 15,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(codex_conversation_turn_count_total[$__rate_interval]))", "legendFormat": "turns", "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [], "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } }
    },
    {
      "type": "row",
      "title": "Tool Health",
      "id": 500,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tool Reliability by Tool",
      "id": 16,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "targets": [
        { "refId": "A", "expr": "100 * sum by (tool) (increase(codex_tool_call_total{success=\"true\"}[$__rate_interval])) / clamp_min(sum by (tool) (increase(codex_tool_call_total[$__rate_interval])), 1)", "legendFormat": "{{tool}} success %", "format": "time_series" },
        { "refId": "B", "expr": "sum by (tool) (increase(codex_tool_call_total[$__rate_interval]))", "legendFormat": "{{tool}} calls", "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [], "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "auto" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Tool Latency by Tool",
      "id": 17,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(codex_tool_call_duration_ms_bucket[$__rate_interval])))", "legendFormat": "{{tool}} p50", "format": "time_series" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(codex_tool_call_duration_ms_bucket[$__rate_interval])))", "legendFormat": "{{tool}} p95", "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0, "mappings": [], "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row",
      "title": "Safety & Access",
      "id": 600,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "panels": []
    },
    {
      "type": "piechart",
      "title": "Tool Calls by Sandbox Policy",
      "id": 18,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 46 },
      "targets": [
        { "refId": "A", "expr": "sum by (sandbox_policy) (increase(codex_tool_call_total[$__range]))", "legendFormat": "{{sandbox_policy}}", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "pieType": "pie", "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "right", "values": ["value", "percent"] } }
    },
    {
      "type": "piechart",
      "title": "Approval Outcomes",
      "id": 19,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 46 },
      "targets": [
        { "refId": "A", "expr": "sum by (approved) (increase(codex_approval_requested_total[$__range]))", "legendFormat": "approved={{approved}}", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "pieType": "pie", "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "right", "values": ["value", "percent"] } }
    },
    {
      "type": "piechart",
      "title": "Sessions by Client",
      "id": 20,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 46 },
      "targets": [
        { "refId": "A", "expr": "sum by (originator) (increase(codex_thread_started_total[$__range]))", "legendFormat": "{{originator}}", "instant": true, "range": false, "format": "time_series" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "pieType": "pie", "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "right", "values": ["value", "percent"] } }
    },
    {
      "type": "row",
      "title": "Logs",
      "id": 700,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Codex Telemetry Logs",
      "id": 21,
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Codex OTLP logs stored in Loki. Loki's native OTLP ingestion keeps trace_id as structured metadata for trace-to-log navigation.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 55 },
      "targets": [
        { "refId": "A", "expr": "{service_name=~\"codex.*\"}" }
      ],
      "fieldConfig": { "defaults": { "mappings": [] }, "overrides": [] },
      "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLines": false, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending" }
    }
  ],
  "links": []
}
